<?xml version="1.0" encoding="utf-8"?>
<!-- W8 (文档 §3): A3 风险详情 / 引导页 —— VerdictEntryData 全字段 + 干预路由深链按钮(§6) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_title_detail"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textIsSelectable="true" />

        <!-- W8 (文档 §6): 干预路由深链按钮 —— 文本由 InterventionKind 决定 -->
        <Button
            android:id="@+id/btnIntervention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvInterventionNone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ui_intervention_none"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>