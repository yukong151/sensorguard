<?xml version="1.0" encoding="utf-8"?>
<!-- W8 (文档 §3): A2 事件时间线 —— 探针事件 + 告警列表(新→旧),点击进入 A3 详情 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTimelineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_title_timeline"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- W12/P0-1 增强:时间线筛选开关。默认开启——真实用户可见"连系统自身的传感器调用
         都被捕获",从而确信 App 真实有效;关闭后仅展示第三方 App 调用,聚焦可疑滥用。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_filter_system"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_filter_system_hint"
                android:textSize="11sp"
                android:textColor="#888888" />
        </LinearLayout>

        <Switch
            android:id="@+id/swSystem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <ListView
        android:id="@+id/listTimeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp" />
</LinearLayout>